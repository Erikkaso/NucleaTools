# Production webhook of the existing streaming n8n workflow.
N8N_WEBHOOK_URL=https://n8n.example.com/webhook/REPLACE_WITH_YOUR_WEBHOOK_ID

# When the gateway runs inside the same Kubernetes network as the TTS:
TTS_BASE_URL=http://ollama-service.ollama-system.svc.cluster.local:8000
# For a local TTS exposed on this computer, use http://127.0.0.1:8000 instead.

N8N_TIMEOUT_SECONDS=220
TTS_STREAM_TIMEOUT_SECONDS=90
PORT=5000
