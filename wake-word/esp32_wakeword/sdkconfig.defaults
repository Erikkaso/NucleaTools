CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_ESPTOOLPY_FLASHSIZE="16MB"
CONFIG_ESPTOOLPY_HEADER_FLASHSIZE_UPDATE=y
CONFIG_ESP_MAIN_TASK_STACK_SIZE=16384
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_USE_CAPS_ALLOC=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_NUCLEA_DISPLAY_ENABLED=y
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y
CONFIG_NUCLEA_MIN_RECORDING_MS=3000
CONFIG_NUCLEA_SILENCE_MS=1500
CONFIG_NUCLEA_MAX_RECORDING_MS=12000
CONFIG_NUCLEA_SPEAKER_VOLUME_PERCENT=100
CONFIG_NUCLEA_SPEAKER_BOOST_DB=6
CONFIG_NUCLEA_SPEAKER_LIMIT_DBFS=-3
CONFIG_NUCLEA_SPEAKER_HIGHPASS_HZ=150
CONFIG_NUCLEA_PIEZO_ENABLED=y
CONFIG_NUCLEA_PIEZO_GPIO=1
# CONFIG_NUCLEA_PIEZO_KNOCK_MODE is not set
CONFIG_NUCLEA_PIEZO_SHAKE_BUCKETS=4
CONFIG_NUCLEA_PIEZO_MIN_PULSES=60
# CONFIG_NUCLEA_PIEZO_PULLDOWN is not set
